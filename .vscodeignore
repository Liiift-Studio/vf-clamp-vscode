src/
# Exclude all of node_modules EXCEPT the production runtime tree, which must ship in the
# VSIX — @liiift-studio/vf-clamp loads it from disk at runtime and cannot be bundled.
node_modules/**
!node_modules/@liiift-studio/**
!node_modules/@web-alchemy/**
!node_modules/pyodide/**
!node_modules/ws/**
!node_modules/@types/emscripten/**
.vscode/
.vscode-test/
.github/
out/
**/*.ts
!dist/**
!dist/**/*.d.ts
**/*.map
**/tsconfig*.json
esbuild.mjs
CLAUDE.md
.eslintrc*
.editorconfig
.gitignore
.gitattributes
.npmrc
package-lock.json
*.vsix
